# 复制为项目根目录 .env，再填写真实配置；修改后重新启动程序。
# 当前进程中已有的同名环境变量优先于 .env。

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-your-available-model
DEEPSEEK_MEMORY_MODEL=replace-with-your-available-model

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=4096

# web 搜索需要 Tavily Key。
TAVILY_API_KEY=

# GitHub 公开仓库可匿名访问，也可填写 Token。
GITHUB_TOKEN=